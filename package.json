{
  "name": "@your-scope/dsh-auto-team",
  "description": "Score-gated Agent Teams workflow for DeepSeek Harness",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "auto-team",
    "agent-team",
    "goal"
  ],
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "version": "0.0.1",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src/assets/locale/*.json",
    "src/assets/icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./src/assets/locale/*.json",
    "./icon": "./src/assets/icon.svg",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "icon": "./src/assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt src tests",
    "fmt:check": "oxfmt --check src tests",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "test": "vitest run",
    "extract:patch": "node scripts/extract-patch.mjs",
    "patch:host": "bash scripts/patch.sh"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}